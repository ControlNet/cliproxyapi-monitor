# CLIProxyAPI management Center
# Optional when dashboard runs in Docker with mounted config.yaml.
CLIPROXY_SECRET_KEY=
# Optional explicit management credential for `/v0/management/*`, RESP AUTH, and `/usage-queue`.
# Prefer this over reusing CLIPROXY_SECRET_KEY. If empty, the app falls back to MANAGEMENT_PASSWORD, then CLIPROXY_SECRET_KEY.
CLIPROXY_MANAGEMENT_KEY=
# Required. Include protocol. Internal Docker HTTP is supported.
# Examples: http://cli-proxy-api:8317 (docker internal), https://your-domain.com (public HTTPS)
CLIPROXY_API_BASE_URL=

# Database
DATABASE_URL=
# Optional fallback if your platform exposes POSTGRES_URL instead of DATABASE_URL.
POSTGRES_URL=
# Optional PostgreSQL CA certificate for SSL verification.
# Supports raw PEM content or base64-encoded PEM.
DATABASE_CA=
# Optional connection pool tuning.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=30000
DATABASE_POOL_MAX_USES=7500

# Security
PASSWORD=
# Auth cookie security policy for both admin and user sessions: default false/empty for internal HTTP.
# Set AUTH_COOKIE_SECURE=true when dashboard is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Optional user-safe global overview on `/user`. Default off.
# When enabled, logged-in users can switch `/api/user/overview?view=global` and the `/user` global aggregate view.
ALLOW_USER_SEE_TOTAL_USAGE=false
# Optional user-safe quota summary panel/API. Default off.
# When enabled, logged-in users can read `/api/user/quota` and see a compact quota summary on `/user`.
ALLOW_USER_SEE_QUOTA=false
CRON_SECRET=<any-long-secret-string>

# Optional sync tuning (milliseconds / row chunk size)
NEXT_PUBLIC_SYNC_TIMEOUT_MS=60000
# Queue-first sync tuning for latest CPA. `auto` tries RESP first, then HTTP `/usage-queue`, then legacy `/usage`.
# Queue reads are destructive, and default retention is usually about 60 seconds, so keep your sync schedule short.
CLIPROXY_USAGE_QUEUE_SOURCE=auto
CLIPROXY_USAGE_QUEUE_BATCH_SIZE=100
CLIPROXY_USAGE_QUEUE_TIMEOUT_MS=15000
AUTH_FILES_INSERT_CHUNK_SIZE=500
USAGE_INSERT_CHUNK_SIZE=153
